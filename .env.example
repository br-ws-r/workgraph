# Load through your service manager or shell; Workgraph does not load this file.
# Example values only. Never commit real credentials.
COGNEE_SERVICE_URL=https://cognee.example.com
COGNEE_AUTH_SCHEME=bearer
COGNEE_API_KEY=replace-with-a-token
# Cognee Cloud only:
# COGNEE_TENANT_ID=replace-with-tenant-id
WORKGRAPH_COGNEE_TIMEOUT_MS=3000
WORKGRAPH_COGNEE_REMEMBER_TIMEOUT_MS=120000
# Provision this persistent directory for the agent OS user:
WORKGRAPH_DATA_DIR=/var/lib/workgraph
# MULTICA_BIN=/usr/local/bin/multica
# Managed identity is supplied per run by Multica, not hardcoded here.
