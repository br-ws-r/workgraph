    "agent-memory",
    "graphrag"
  ],
  "license": "MIT",
  "author": "Kerry Hatcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerryhatcher/pi-cognee.git"
  },
  "bugs": {
    "url": "https://github.com/kerryhatcher/pi-cognee/issues"
  },
  "homepage": "https://github.com/kerryhatcher/pi-cognee#readme",
