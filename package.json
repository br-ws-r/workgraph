{
  "name": "@br-ws-r/workgraph",
  "version": "0.1.0",
  "description": "Opinionated initiative-scoped knowledge graph and durable memory for Pi runs managed by Multica",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.0.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./pi": { "types": "./dist/src/pi.d.ts", "import": "./dist/src/pi.js" }
  },
  "pi": { "extensions": ["./dist/src/pi.js"] },
  "files": ["dist", "docs", "README.md", "LICENSE", "CHANGELOG.md"],
  "repository": { "type": "git", "url": "git+https://github.com/br-ws-r/workgraph.git" },
  "bugs": { "url": "https://github.com/br-ws-r/workgraph/issues" },
  "homepage": "https://github.com/br-ws-r/workgraph#readme",
  "keywords": ["pi-package", "multica", "cognee", "knowledge-graph", "agent-memory"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.4",
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "typebox": ">=1.0.0"
  },
  "dependencies": { "zod": "4.0.17" },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "24.3.0",
    "typebox": "1.0.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
